# Employee table (single UInt64 primary key), sequential union mode.
# Exercises SequentialUnionExec for OR conditions (same results as parallel).

query ITIT rowsort
SELECT * FROM employees WHERE age = 25 OR age = 35
----
1 Alice 25 Engineering
3 Charlie 35 Marketing

query ITIT rowsort
SELECT * FROM employees WHERE age = 25 OR age = 30 OR age = 35
----
1 Alice 25 Engineering
2 Bob 30 Sales
3 Charlie 35 Marketing

query ITIT rowsort
SELECT * FROM employees WHERE age = 25 OR department = 'Sales'
----
1 Alice 25 Engineering
2 Bob 30 Sales
5 Eve 32 Sales

query ITIT rowsort
SELECT * FROM employees WHERE
    (age >= 25 AND department = 'Engineering') OR
    (age >= 30 AND department = 'Sales')
----
1 Alice 25 Engineering
2 Bob 30 Sales
4 David 28 Engineering
5 Eve 32 Sales

query ITIT rowsort
SELECT * FROM employees WHERE age = 25 OR age < 29
----
1 Alice 25 Engineering
4 David 28 Engineering

# --- OR mixing an indexed and a non-indexed column must not be dropped ---

query ITIT rowsort
SELECT * FROM employees WHERE age < 31 AND (age = 30 OR name = 'Eve')
----
2 Bob 30 Sales

query ITIT rowsort
SELECT * FROM employees WHERE age = 30 OR name = 'Eve'
----
2 Bob 30 Sales
5 Eve 32 Sales

# --- projection must be applied to index scans ---

query T rowsort
SELECT name FROM employees WHERE age = 30
----
Bob

# projected columns in non-prefix order
query IT rowsort
SELECT age, name FROM employees WHERE age = 30
----
30 Bob

# remaining filter references an unprojected column (name is projected, age is not)
query T rowsort
SELECT name FROM employees WHERE age < 31 AND (age = 30 OR name = 'Eve')
----
Bob

# zero-column projection must keep the row count
query I rowsort
SELECT count(*) FROM employees WHERE age < 31 AND (age = 30 OR name = 'Eve')
----
1

query I rowsort
SELECT count(*) FROM employees WHERE department = 'Sales'
----
2

# OR union with a projection and a limit
query T
SELECT name FROM employees WHERE age = 25 OR age = 30 ORDER BY name LIMIT 1
----
Alice
